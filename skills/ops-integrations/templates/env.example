# Environment variables the MCP servers and integrations expect.
#
# Claude Code does NOT read this file. ${VAR} in .mcp.json is resolved from the
# PROCESS environment, so these must be set before Claude Code starts:
#
#   Windows   setx HELPDESK_TOKEN "..."      (new terminals only; survives reboot)
#   POSIX     export HELPDESK_TOKEN="..."    in ~/.bashrc or ~/.zshrc
#
# Copy to a gitignored location, fill in, and load it from your shell profile.
# NEVER commit the filled-in copy. NEVER paste a value into .mcp.json.

# --- Acme Helpdesk (ticket queue) ---
HELPDESK_URL=https://helpdesk.example.com
HELPDESK_TOKEN=

# --- Where the project repos live on THIS machine (tickets_store records repos
#     relative to it; default C:/projects) ---
PROJECTS_ROOT=

# --- Gemini (ticket triage, mail AI); agent_view also reads its config file ---
GEMINI_API_KEY=

# --- Per-project Python interpreter, referenced as ${PROJECT_VENV} ---
# Avoids absolute paths that break on another machine or user profile.
PROJECT_VENV=

# --- Database inspection (READ-ONLY user, never the application user) ---
MYSQL_RO_HOST=
MYSQL_RO_USER=
MYSQL_RO_PASSWORD=
MYSQL_RO_DATABASE=

# --- GitHub, if the GitHub MCP server is enabled ---
GITHUB_TOKEN=
